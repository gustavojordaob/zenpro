NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_CONTATO_EMAIL_DONO=
NEXT_PUBLIC_WHATSAPP_ATENDIMENTO=5519996331110

# Site (URLs de retorno Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://usezenpro.com.br

# Pagamentos — produção usa Mercado Pago; dev pode simular com true
NEXT_PUBLIC_MOCK_PAGAMENTO=false
# NEXT_PUBLIC_MP_SANDBOX=true

# Mercado Pago — Access Token fica SOMENTE no Firebase Functions (secret MP_ACCESS_TOKEN)
# Public Key (frontend, se usar Brick no futuro):
# NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-...
# Client ID / Secret só para OAuth — não commitam; guardar fora do Git
# Configurar: firebase functions:secrets:set MP_ACCESS_TOKEN
# Webhook: https://us-central1-zenpro-capinhas.cloudfunctions.net/webhookMercadoPago

# Nota fiscal automática — ver functions/.env.example (Focus NFe, CNPJ + e-CNPJ)
# FOCUS_NFE_TOKEN=
# FOCUS_NFE_AMBIENTE=homologacao
# FOCUS_NFE_CNPJ_EMITENTE=
# FOCUS_NFE_NOME_EMITENTE=
# FOCUS_NFE_REGIME_TRIBUTARIO=1
# FOCUS_NFE_IE_EMITENTE=ISENTO
# FOCUS_NFE_NCM_PADRAO=39269090
# FOCUS_NFE_ICMS_CSOSN=102

# Melhor Envio — cotação de frete (token em Firebase Secret)
# firebase functions:secrets:set MELHOR_ENVIO_TOKEN
# Params opcionais em functions/.env:
# MELHOR_ENVIO_USER_AGENT=Zen Pro (email@dominio.com)
# MELHOR_ENVIO_SANDBOX=false
# Produto: pesoGramas + alturaCm + larguraCm + comprimentoCm
# CEP origem: lojas/{id}.config.expedicao

# Cloud Functions — envio automático de e-mail (aprovacao revendedor)
# Opcao 1: Resend (recomendado)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Zen Pro <contato@seudominio.com.br>
#
# Opcao 2: SMTP (Gmail app password, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Zen Pro <seu@gmail.com>
