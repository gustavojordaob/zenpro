rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isMarca() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.papel == 'marca';
    }

    function revendedorDaLoja(lojaId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.papel == 'revendedor'
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.lojaId == lojaId;
    }

    match /personalizacoes/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /artes-producao/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == userId || isMarca())
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'image/png';
    }

    match /lojas/{lojaId}/{fileName} {
      allow read: if true;
      allow write: if (isMarca() || revendedorDaLoja(lojaId))
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /produtos/{produtoId}/{fileName} {
      allow read: if true;
      allow write: if isMarca()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /modelos/{modeloId}/{fileName} {
      allow read: if true;
      allow write: if isMarca()
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
