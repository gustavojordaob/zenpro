SITE_URL=https://zenpro-capinhas.web.app

# ── Focus NFe — emitente CNPJ (Simples Nacional, Sefaz-SP = e-CNPJ A1) ──
# Token: painel Focus → Empresa (CNPJ) → aba TOKENS → Homologação ou Produção
FOCUS_NFE_TOKEN=
FOCUS_NFE_AMBIENTE=homologacao
# FOCUS_NFE_TOKEN_PROD=

FOCUS_NFE_CNPJ_EMITENTE=
FOCUS_NFE_CPF_EMITENTE=
FOCUS_NFE_NOME_EMITENTE=JORDAO DESENVOLVIMENTO DE SOFTWARE LTDA

# CRT: 1=Simples Nacional | 3=Regime Normal | 4=MEI
FOCUS_NFE_REGIME_TRIBUTARIO=1
FOCUS_NFE_IE_EMITENTE=ISENTO

# Tributação itens (validar com contador)
FOCUS_NFE_NCM_PADRAO=39269090
FOCUS_NFE_ICMS_CSOSN=102
FOCUS_NFE_PIS_CST=07
FOCUS_NFE_COFINS_CST=07

# Melhor Envio — etiqueta automática (postagem em agência, SEM coleta)
# Token: firebase functions:secrets:set MELHOR_ENVIO_TOKEN
MELHOR_ENVIO_USER_AGENT=Zen Pro (contato@zenpro-capinhas.web.app)
MELHOR_ENVIO_SANDBOX=false
MELHOR_ENVIO_CPF_REMETENTE=00000000000
MELHOR_ENVIO_TELEFONE_REMETENTE=5511999999999
MELHOR_ENVIO_EMAIL_REMETENTE=contato@zenpro-capinhas.web.app
MELHOR_ENVIO_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=Zen Pro <noreply@zenpro-capinhas.web.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
