{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/revendedor/personalizar", "destination": "/revendedor/personalizar.html" },
      { "source": "/revendedor/produto", "destination": "/revendedor/produto.html" },
      { "source": "/revendedor/promocao", "destination": "/revendedor/promocao.html" },
      { "source": "/revendedor/c/**", "destination": "/revendedor/c/capinhas.html" },
      { "source": "/revendedor/carrinho", "destination": "/revendedor/carrinho.html" },
      { "source": "/revendedor/checkout/retorno", "destination": "/revendedor/checkout/retorno.html" },
      { "source": "/revendedor/checkout", "destination": "/revendedor/checkout.html" },
      { "source": "/revendedor", "destination": "/revendedor.html" },
      { "source": "/*/personalizar", "destination": "/loja/personalizar.html" },
      { "source": "/*/produto", "destination": "/loja/produto.html" },
      { "source": "/*/promocao", "destination": "/loja/promocao.html" },
      { "source": "/*/c/**", "destination": "/loja/c/capinhas.html" },
      { "source": "/*/carrinho", "destination": "/loja/carrinho.html" },
      { "source": "/*/checkout/retorno", "destination": "/loja/checkout/retorno.html" },
      { "source": "/*/checkout", "destination": "/loja/checkout.html" },
      { "source": "/*", "destination": "/loja.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8090
    },
    "ui": {
      "enabled": false
    }
  }
}
